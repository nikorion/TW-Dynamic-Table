tags: $:/tags/Stylesheet
title: $:/plugins/nikorion/table/styles/task-complete
type: text/vnd.tiddlywiki

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline conditional

/* whole-row highlight for status: TW-Base-Fields' `done`/`dropped`/`paused` values (see
   tbl-row-class() in segments/dt-tbody). Text/links are forced to a near-white (light scheme) or
   near-black (dark scheme) colour below, so the background needs to stay dark/saturated enough for
   that to read. */

.tbl-record-complete,
.tbl-record-complete svg,
.tbl-record-complete a.tc-tiddlylink,
.tbl-record-dropped,
.tbl-record-dropped svg,
.tbl-record-dropped a.tc-tiddlylink,
.tbl-record-paused,
.tbl-record-paused svg,
.tbl-record-paused a.tc-tiddlylink {
<%if [<table-color-scheme>match[light]] %>
color: #F2F2F7;
fill: currentColor;
<%elseif [<table-color-scheme>match[dark]] %>
color: rgba(139, 195, 74, 1);
fill: currentColor;
<%endif%>
}

.tbl-record-complete {
<%if [<table-color-scheme>match[light]] %>
background-color: #2e7d32; /* forest green */
<%elseif [<table-color-scheme>match[dark]] %>
background-color: #1b3a1b; /* deep green */
<%endif%>
}

.tbl-record-dropped {
<%if [<table-color-scheme>match[light]] %>
background-color: #a13939; /* brick red */
<%elseif [<table-color-scheme>match[dark]] %>
background-color: #3a1b1b; /* deep red */
<%endif%>
}

.tbl-record-paused {
<%if [<table-color-scheme>match[light]] %>
background-color: #6f9bc9; /* pale steel blue */
<%elseif [<table-color-scheme>match[dark]] %>
background-color: #263a4a; /* pale deep blue */
<%endif%>
}
