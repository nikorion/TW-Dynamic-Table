tags: $:/tags/Stylesheet
title: $:/plugins/nikorion/table/styles/task-complete
type: text/vnd.tiddlywiki

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline conditional

/* whole-row text colour for status: TW-Base-Fields' `done` (pale green, theme-aware) / `dropped` (grey) values (see tbl-row-class()
   in segments/dt-tbody). `paused` (class tbl-record-paused) is deliberately left unstyled. */

.tbl-record-complete,
.tbl-record-complete svg,
.tbl-record-complete a.tc-tiddlylink {
<%if [<table-color-scheme>match[dark]] %>
color: #a5d6a7; /* pale green on dark */
<%else%>
color: #6fae73; /* pale green, still readable on light */
<%endif%>
fill: currentColor;
}

.tbl-record-dropped,
.tbl-record-dropped svg,
.tbl-record-dropped a.tc-tiddlylink {
color: #8a8a8a;
fill: currentColor;
}

/* title column stays normal on finished tasks */
.tbl-record-complete .tbldyn-title {
color: <<colour foreground>>;
}

.tbl-record-complete .tbldyn-title a.tc-tiddlylink {
color: <<colour tiddler-link-foreground>>;
}

.tbl-record-complete .tbldyn-title svg {
fill: <<colour foreground>>;
}
