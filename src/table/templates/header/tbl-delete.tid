tags: $:/tags/Table/HeaderTemplate
tbl-column-list: tbl-delete
title: $:/plugins/nikorion/table/templates/header/tbl-delete
type: text/vnd.tiddlywiki

\procedure mark-for-delete() <$action-setfield $tiddler="$:/temp/nikorion/table/delete-all-records" $index=<<currentTable>> $value="to-be-deleted"/>

<%if [<tempTableEdit>getindex[mode]match[edit]] %>
<th class="tbldyn-svg">
  <span>
  <$button class="tc-btn-invisible" tooltip=<<table-lingo-text "Tables/Delete/AllTooltip">> aria-label=<<table-lingo-text "Tables/Delete/AllTooltip">> actions=<<mark-for-delete>> >
	  {{$:/core/images/delete-button}}
  </$button>
  </span>
</th>
<%endif%>
<!--
delete button is only shown in edit mode
-->
