tags: $:/tags/Table/BodyTemplate
tbl-column-list: tbl-expand
title: $:/plugins/nikorion/table/templates/body/tbl-expand
type: text/vnd.tiddlywiki

\procedure doExpand()   <$action-setfield $tiddler=<<tempTableExpand>> $index=<<currentRecord>> $value="show" />
\procedure doCollapse() <$action-setfield $tiddler=<<tempTableExpand>> $index=<<currentRecord>> />
<%if [<tempTableExpand>getindex<currentRecord>match[show]] %>
	<td><$button class="tc-btn-invisible tc-tiddlylink" tooltip=<<table-lingo-text "Tables/Expand/CollapseTooltip">> aria-label=<<table-lingo-text "Tables/Expand/CollapseTooltip">> actions=<<doCollapse>> >
		{{$:/core/images/down-arrow}}
	</$button></td>
<%else%>
	<td><$button class="tc-btn-invisible tc-tiddlylink" tooltip=<<table-lingo-text "Tables/Expand/ExpandTooltip">> aria-label=<<table-lingo-text "Tables/Expand/ExpandTooltip">> actions=<<doExpand>> >
		{{$:/core/images/right-arrow}}
	</$button></td>
<%endif%>
