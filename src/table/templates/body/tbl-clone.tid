tags: $:/tags/Table/BodyTemplate
tbl-column-list: tbl-clone
title: $:/plugins/nikorion/table/templates/body/tbl-clone
type: text/vnd.tiddlywiki

\function tempTableCloneName()  [<tempTable>]"clone-name"+[join[/]]
\function clone-popup-state()   [<qualify "$:/state/popup/tbl-clone">] [<currentTable>] [<currentRecord>] +[join[/]]
\function clone-default-title() [<currentRecord>addsuffix[ 1]]
\function clone-newtitle-value() [<tempTableCloneName>getindex<currentRecord>] :else[<clone-default-title>]

\procedure close-clone() <$action-setfield $tiddler=<<tempTableCloneName>> $index=<<currentRecord>>/><$action-deletetiddler $tiddler=<<clone-popup-state>>/>
\procedure clone-record-as()
<%if [<clone-newtitle-value>is[missing]] %>
<$action-createtiddler $basetitle=<<clone-newtitle-value>> $overwrite="yes" $template=<<currentRecord>> />
<<close-clone>>
<%endif%>
\end clone-record-as

<%if [<tempTableEdit>getindex[mode]match[edit]] %><!-- only works in edit mode-->
<td class="tbldyn-svg">
  <$button popup=<<clone-popup-state>> popupAbsCoords="yes" class="tc-btn-invisible" tooltip=<<table-lingo-text "Tables/Clone/RecordTooltip">> aria-label=<<table-lingo-text "Tables/Clone/RecordTooltip">>>
	  {{$:/core/images/clone-button}}
	</$button>
  <$reveal state=<<clone-popup-state>> type="popup" position="below" animate="yes" class="tc-drop-down">
    <div class="tbldyn-clone-popup tc-popup-keep">
      <label class="tbldyn-clone-label"><<table-lingo-text "Tables/Clone/NameLabel">></label>
      <$edit-text tiddler=<<tempTableCloneName>> index=<<currentRecord>> default=<<clone-default-title>> tag="input" class="tbldyn-textbox" focus="true"/>
      <%if [<clone-newtitle-value>!is[missing]] %>
        <div class="tbldyn-clone-warning">{{$:/core/images/warning}} <<table-lingo-text "Tables/Clone/ExistsWarning">></div>
      <%endif%>
      <$button class="tc-btn-invisible" tooltip=<<table-lingo-text "Tables/Clone/Confirm">> aria-label=<<table-lingo-text "Tables/Clone/Confirm">> actions=<<clone-record-as>>>{{$:/core/images/done-button}} <<table-lingo "Tables/Clone/Confirm">></$button>
      <$button class="tc-btn-invisible" tooltip=<<table-lingo-text "Tables/Clone/Cancel">> aria-label=<<table-lingo-text "Tables/Clone/Cancel">> actions=<<close-clone>>>{{$:/core/images/close-button}}</$button>
    </div>
  </$reveal>
</td>
<%endif%>
