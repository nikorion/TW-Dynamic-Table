tags: $:/tags/nk-Table/BodyTemplate
tbl-column-list: priority
title: $:/plugins/nikorion/table/templates/body/priority
type: text/vnd.tiddlywiki

<!-- the emoji is a purely visual marker, like TW-Base-Fields' vocab icons: never stored, the field keeps its plain 1-5 value -->
\procedure show-cell()
	<%if [<currentRecord>get<currentColumn>match[5]] %>
		🔴&nbsp;<<table-lingo "Tables/Priority/very-high">>
	<%elseif [<currentRecord>get<currentColumn>match[4]] %>
		🟠&nbsp;<<table-lingo "Tables/Priority/high">>
	<%elseif [<currentRecord>get<currentColumn>match[3]] %>
		🟡&nbsp;<<table-lingo "Tables/Priority/normal">>
	<%elseif [<currentRecord>get<currentColumn>match[2]] %>
		🔵&nbsp;<<table-lingo "Tables/Priority/low">>
	<%elseif [<currentRecord>get<currentColumn>match[1]] %>
		⚪&nbsp;<<table-lingo "Tables/Priority/very-low">>
	<%endif%>
\end show-cell

\procedure show-cell-locked() <span class="tbldyn-locked-cell"><<show-cell>></span>

\procedure select_priority()
<$select tiddler=<<currentRecord>> field=<<currentColumn>> default="">
<option value=''><<table-lingo "Tables/Select">></option>
<option value='5'>🔴 <<table-lingo "Tables/Priority/very-high">></option>
<option value='4'>🟠 <<table-lingo "Tables/Priority/high">></option>
<option value='3'>🟡 <<table-lingo "Tables/Priority/normal">></option>
<option value='2'>🔵 <<table-lingo "Tables/Priority/low">></option>
<option value='1'>⚪ <<table-lingo "Tables/Priority/very-low">></option>
<option value=''><<table-lingo "Tables/Priority/no-priority">></option>
</$select>
\end select_priority

<td class="tbldyn-priority">
<%if [<tempTableEdit>is[missing]] :or[<tempTableEdit>getindex[mode]!match[edit]] %>
	<<show-cell>>
<%elseif [<tempTableSort>getindex[sortIndex]match<currentColumn>] %><!--check if the current column is not selected for sorting-->
	<<show-cell-locked>>
<%else%>
	<<select_priority>>
<%endif%>
</td>

<!-- Part of Task Manager
   this template ALWAYS works on fields
  -->
