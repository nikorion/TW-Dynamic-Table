title: $:/plugins/nikorion/table/segments/dt-tfoot
type: text/vnd.tiddlywiki

\function frows() "[range[1,$(footerRows)$]addprefix[footer-]]" :map[substitute[]]
<%if [<footerRows>compare:integer:gt[0]] %>
<tr><td colspan=<<columnsCount>> class="tbldyn-numerical-summary-lbl"><<table-lingo "Tables/Footer/Summary">></td></tr>
<$list filter=<<frows>> variable=footerRow>
<tr>
<$list filter=<<columnFilter>> variable=currentColumn>
	<$set name="footerLookup"
				filter="[all[tiddlers+shadows]tag[$:/tags/nk-Table/FooterTemplate]!is[draft]contains:tbl-column-list<currentColumn>limit[1]get[title]]"
				value=<<footerLookup>>
				emptyValue="$:/plugins/nikorion/table/templates/footer/default">
	<$transclude $tiddler=<<footerLookup>> $field="text" $mode="inline"/>
	</$set>
</$list>
</tr>
</$list>
<%endif%>