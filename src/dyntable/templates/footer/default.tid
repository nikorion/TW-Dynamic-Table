tags: $:/tags/nk-dyntable/FooterTemplate
title: $:/plugins/nikorion/dyntable/templates/footer/default
type: text/vnd.tiddlywiki

<$let	idx={{{ [<currentColumn>addsuffix[/]addsuffix<footerRow>] }}} >
	<%if [<tempTableEdit>getindex[mode]match[edit]] %>
		<td>
			<$edit-text tiddler=<<stateTableFooter>> index=<<idx>> tag="input" class="nk-dyntable-textbox"/>
		</td>
	<%else%>
		<td>
			<$let val={{{ [<stateTableFooter>getindex<idx>trim[]] }}}
				label={{{ [function[dyntable-lingo-value],[Tables/Footer/],<val>] }}}
					tipName={{{ [function[dyntable-lingo-value],[Tables/FooterName/],<val>] }}}
      tipDesc={{{ [function[dyntable-lingo-value],[Tables/FooterDesc/],<val>] }}} >
				<%if [<label>!match<val>] %>
					<span class="nk-dyntable-footer-label"><$text text=<<label>>/><<dyntable-lingo "Tables/Footer/LabelSuffix">><span class="nk-dyntable-footer-tip"><strong><$text text=<<tipName>>/></strong><br><$text text=<<tipDesc>>/></span></span>
				<%else%>
					<$transclude tiddler=<<stateTableFooter>> index=<<idx>> mode="inline" />
				<%endif%>
			</$let>
		</td>
	<%endif%>
</$let>