tags: $:/tags/nk-dyntable/BodyTemplate
nk-dyntable-column-list: nk-clone
title: $:/plugins/nikorion/dyntable/templates/body/nk-clone
type: text/vnd.tiddlywiki

\function tempTableCloneName()  [<tempTable>]"clone-name"+[join[/]]
\function clone-popup-state()   [<qualify "$:/state/popup/nk-dyntable-clone">] [<currentTable>] [<currentRecord>] +[join[/]]
\function clone-default-title() [<currentRecord>addsuffix[ 1]]
\function clone-newtitle-value() [<tempTableCloneName>getindex<currentRecord>] :else[<clone-default-title>]

\procedure close-clone() <$action-setfield $tiddler=<<tempTableCloneName>> $index=<<currentRecord>>/><$action-deletetiddler $tiddler=<<clone-popup-state>>/>
\procedure clone-record-as()
<%if [<clone-newtitle-value>is[missing]] %>
<$action-createtiddler $basetitle=<<clone-newtitle-value>> $overwrite="yes" $template=<<currentRecord>> />
<<close-clone>>
<%endif%>
\end clone-record-as

<%if [<tempTableEdit>getindex[mode]match[edit]] %><!-- only works in edit mode-->
<td class="nk-dyntable-svg">
  <$button popup=<<clone-popup-state>> popupAbsCoords="yes" class="tc-btn-invisible" tooltip=<<dyntable-lingo-text "Tables/Clone/RecordTooltip">> aria-label=<<dyntable-lingo-text "Tables/Clone/RecordTooltip">>>
	  {{$:/core/images/clone-button}}
	</$button>
  <$reveal state=<<clone-popup-state>> type="popup" position="below" animate="yes" class="tc-drop-down">
    <div class="nk-dyntable-clone-popup tc-popup-keep">
      <label class="nk-dyntable-clone-label"><<dyntable-lingo-text "Tables/Clone/NameLabel">></label>
      <$edit-text tiddler=<<tempTableCloneName>> index=<<currentRecord>> default=<<clone-default-title>> tag="input" class="nk-dyntable-textbox" focus="true"/>
      <%if [<clone-newtitle-value>!is[missing]] %>
        <div class="nk-dyntable-clone-warning">{{$:/core/images/warning}} <<dyntable-lingo-text "Tables/Clone/ExistsWarning">></div>
      <%endif%>
      <$button class="tc-btn-invisible" tooltip=<<dyntable-lingo-text "Tables/Clone/Confirm">> aria-label=<<dyntable-lingo-text "Tables/Clone/Confirm">> actions=<<clone-record-as>>>{{$:/core/images/done-button}} <<dyntable-lingo "Tables/Clone/Confirm">></$button>
      <$button class="tc-btn-invisible" tooltip=<<dyntable-lingo-text "Tables/Clone/Cancel">> aria-label=<<dyntable-lingo-text "Tables/Clone/Cancel">> actions=<<close-clone>>>{{$:/core/images/close-button}}</$button>
    </div>
  </$reveal>
</td>
<%endif%>
