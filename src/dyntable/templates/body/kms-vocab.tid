tags: $:/tags/nk-Table/BodyTemplate
tbl-column-filter: [[$:/plugins/nikorion/kms-ontology/fields/]addsuffix<currentColumn>get[kind]match[vocab]]
title: $:/plugins/nikorion/dyntable/templates/body/kms-vocab
type: text/vnd.tiddlywiki

<!-- Any field of the kms ontology whose kind is `vocab` (role, maturity, lifecycle…): see procedures/dt-kms. -->

\procedure show-cell() <<tbl-kms-vocab-cell>>
\procedure show-cell-locked() <span class="tbldyn-locked-cell"><<tbl-kms-vocab-cell>></span>

<td class="tbldyn-col-fixedsize">
<%if [<tempTableEdit>is[missing]] :or[<tempTableEdit>getindex[mode]!match[edit]] %>
	<<show-cell>>
<%elseif [<tempTableSort>getindex[sortIndex]match<currentColumn>] %><!--check if the current column is not selected for sorting-->
	<<show-cell-locked>>
<%else%>
	<<tbl-kms-select actions=<<tbl-kms-clear-empty>> >>
<%endif%>
</td>
