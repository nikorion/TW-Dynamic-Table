tags: $:/tags/nk-Table/BodyTemplate
tbl-column-list: maturity lifecycle
title: $:/plugins/nikorion/dyntable/templates/body/vocab
type: text/vnd.tiddlywiki

<!-- Single-value controlled vocabularies of TW-Base-Fields with no grouping (`role` and `status`
  have templates of their own): values, icons and labels come from
  $:/plugins/nikorion/base-fields/vocab/<column>. Without that plugin the columns show the raw
  stored value and edit it as free text (see tbl-bf-vocab() in procedures/dt-helper).
  A vocabulary with a `blank-value` (`maturity`: stub, `lifecycle`: active) has no placeholder
  option: its blank value //is// the empty field, as in the TW-Base-Fields editor — choosing it
  clears the field. -->

\procedure show-cell()
<%if [function[tbl-bf-vocab]] %>
<%if [<currentRecord>get<currentColumn>!is[blank]] %>
<$transclude $variable="bf-vocab-item" field=<<currentColumn>> value={{{ [<currentRecord>get<currentColumn>] }}}/>
<%endif%>
<%else%>
<<tbl-raw-cell>>
<%endif%>
\end show-cell

\procedure show-cell-locked() <span class="tbldyn-locked-cell"><<show-cell>></span>

\procedure clear-empty-actions()
<$list filter="[<currentRecord>!has<currentColumn>]" variable="ignore">
<$action-deletefield $tiddler=<<currentRecord>> $field=<<currentColumn>>/>
</$list>
\end clear-empty-actions

\procedure select-vocab()
<$let blank={{{ [[$:/plugins/nikorion/base-fields/vocab/]addsuffix<currentColumn>get[blank-value]] }}}>
<$select tiddler=<<currentRecord>> field=<<currentColumn>> default="" actions=<<clear-empty-actions>>>
<%if [<blank>match[]] %>
<option value=''><<table-lingo "Tables/Select">></option>
<%endif%>
<$list filter="[function[bf-vocab-values],<currentColumn>]" variable="slug">
<option value={{{ [<slug>!match<blank>] }}}><$transclude $variable="bf-vocab-item" field=<<currentColumn>> value=<<slug>>/></option>
</$list>
</$select>
</$let>
\end select-vocab

<td class="tbldyn-col-fixedsize">
<%if [<tempTableEdit>is[missing]] :or[<tempTableEdit>getindex[mode]!match[edit]] %>
	<<show-cell>>
<%elseif [<tempTableSort>getindex[sortIndex]match<currentColumn>] %><!--check if the current column is not selected for sorting-->
	<<show-cell-locked>>
<%elseif [function[tbl-bf-vocab]] %>
	<<select-vocab>>
<%else%>
	<<tbl-raw-edit>>
<%endif%>
</td>
