tags: $:/tags/nk-Table/BodyTemplate
tbl-column-list: role
title: $:/plugins/nikorion/dyntable/templates/body/role
type: text/vnd.tiddlywiki

<!-- Vocabulary (values, icons, labels) is TW-Base-Fields': $:/plugins/nikorion/base-fields/vocab/role.
  Without that plugin the column shows the raw stored value and edits it as free text (see tbl-bf-vocab() in procedures/dt-helper). -->

\procedure show-cell()
<%if [function[tbl-bf-vocab]] %>
<%if [<currentRecord>get<currentColumn>!is[blank]] %>
<$transclude $variable="bf-vocab-item" field="role" value={{{ [<currentRecord>get<currentColumn>] }}}/>
<%endif%>
<%else%>
<<tbl-raw-cell>>
<%endif%>
\end show-cell

\procedure show-cell-locked() <span class="tbldyn-locked-cell"><<show-cell>></span>

\procedure select_role()
<$select tiddler=<<currentRecord>> field=<<currentColumn>> default="">
<option value=''><<table-lingo "Tables/Select">></option>
<$list filter="[function[bf-vocab-ungrouped-values],<currentColumn>]" variable="slug">
<option value=<<slug>>><$transclude $variable="bf-vocab-item" field="role" value=<<slug>>/></option>
</$list>
<$list filter="[function[bf-vocab-groups],<currentColumn>]" variable="group">
<optgroup label={{{ [function[bf-vocab-group-label],<currentColumn>,<group>] }}}>
<$list filter="[function[bf-vocab-group-values],<currentColumn>,<group>]" variable="slug">
<option value=<<slug>>><$transclude $variable="bf-vocab-item" field="role" value=<<slug>>/></option>
</$list>
</optgroup>
</$list>
</$select>
\end select_role

<td class="tbldyn-col-fixedsize">
<%if [<tempTableEdit>is[missing]] :or[<tempTableEdit>getindex[mode]!match[edit]] %>
	<<show-cell>>
<%elseif [<tempTableSort>getindex[sortIndex]match<currentColumn>] %><!--check if the current column is not selected for sorting-->
	<<show-cell-locked>>
<%elseif [function[tbl-bf-vocab]] %>
	<<select_role>>
<%else%>
	<<tbl-raw-edit>>
<%endif%>
</td>
