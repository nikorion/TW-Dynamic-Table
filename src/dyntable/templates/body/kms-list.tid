tags: $:/tags/nk-Table/BodyTemplate
tbl-column-filter: [[$:/plugins/nikorion/kms-ontology/fields/]addsuffix<currentColumn>get[kind]match[list]]
title: $:/plugins/nikorion/dyntable/templates/body/kms-list
type: text/vnd.tiddlywiki

<!-- Any field of the kms ontology whose kind is `list` (disciplines, technology, equipment…): see procedures/dt-kms. -->

\procedure show-cell() <<tbl-kms-pills>>
\procedure show-cell-locked() <span class="tbldyn-locked-cell"><<tbl-kms-pills>></span>

<td class="tbldyn-cell-left">
<%if [<tempTableEdit>is[missing]] :or[<tempTableEdit>getindex[mode]!match[edit]] %>
	<<show-cell>>
<%elseif [<tempTableSort>getindex[sortIndex]match<currentColumn>] %><!--check if the current column is not selected for sorting-->
	<<show-cell-locked>>
<%else%>
	<<tbl-kms-list-edit>>
<%endif%>
</td>
