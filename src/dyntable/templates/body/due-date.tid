tags: $:/tags/nk-Table/BodyTemplate
tbl-column-list: due-date
title: $:/plugins/nikorion/dyntable/templates/body/due-date
type: text/vnd.tiddlywiki

\procedure show-cell()
<$let date-format=<<table-lingo-text "Tables/Format/Date">>
      fmt=`[UTC]$(date-format)$`
      due-date={{{ [<currentRecord>get<currentColumn>] }}} >
	<$let day={{{ [<due-date>split[-]split[.]join[]] }}} today=<<now YYYY0MM0DD>> >
		<%if [<day>regexp[^\d{8}$]compare:integer:lt<today>] %><!-- past date: muted -->
			<span class="tbldyn-overdue"><$text text={{{[<due-date>split[-]split[.]join[]format:date<fmt>]}}} /></span>
		<%else%>
			<$text text={{{[<due-date>split[-]split[.]join[]format:date<fmt>]}}} />
		<%endif%>
	</$let>
</$let>
\end show-cell

\procedure show-cell-locked() <span class="tbldyn-locked-cell"><<show-cell>></span>

\procedure edit-date() 
	<%if [[$:/plugins/kookma/pikaday]!is[missing]] :filter[lookup:no[$:/config/Plugins/Disabled/]match[no]] %>
		<<edit-cell>>
	<%else%>
		<$edit-text tag=input type=date tiddler=<<currentRecord>> field=<<currentColumn>>/>
	<%endif%>
\end edit-date

<td class="tbldyn-date">
	<%if [<tempTableEdit>is[missing]] :or[<tempTableEdit>getindex[mode]!match[edit]] %>
		<<show-cell>>
	<%elseif [<tempTableSort>getindex[sortIndex]match<currentColumn>] %><!--check if the current column is not selected for sorting-->
		<<show-cell-locked>>
	<%else%>
		<<edit-date>>
	<%endif%>
</td>

<!-- Part of Task Manager
  this template ALWAYS works on fields -->