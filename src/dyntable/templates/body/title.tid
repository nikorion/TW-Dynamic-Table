tags: $:/tags/nk-dyntable/BodyTemplate
nk-dyntable-column-list: title
title: $:/plugins/nikorion/dyntable/templates/body/title
type: text/vnd.tiddlywiki

\function tempTableRenameName()  [<tempTable>]"rename-name"+[join[/]]
\function rename-popup-state()   [<qualify "$:/state/popup/nk-dyntable-rename">] [<currentTable>] [<currentRecord>] +[join[/]]
\function rename-newtitle-value() [<tempTableRenameName>getindex<currentRecord>] :else[<currentRecord>]

\procedure close-rename() <$action-setfield $tiddler=<<tempTableRenameName>> $index=<<currentRecord>>/><$action-deletetiddler $tiddler=<<rename-popup-state>>/>
\procedure rename-record-as()
<%if [<rename-newtitle-value>match<currentRecord>] %>
<<close-rename>>
<%elseif [<rename-newtitle-value>is[missing]] %>
<$action-sendmessage $message="tm-rename-tiddler" from=<<currentRecord>> to=<<rename-newtitle-value>>/>
<<close-rename>>
<%endif%>
\end rename-record-as

<td class="nk-dyntable-title nk-dyntable-cell-left">
<!-- the record's caption when it has one, rendered as the core renders it in a tab (wikitext), the link's tooltip
  giving the actual title ("actual title: …", the one the rename button changes); else its title. The table still
  sorts on the title. -->
<%if [<currentRecord>has[caption]] %>
<$let captionTooltip=<<dyntable-lingo-text "Tables/Title/CaptionTooltip">>>
<$link to=<<currentRecord>> tooltip={{{ [<captionTooltip>addsuffix[ ]addsuffix<currentRecord>] }}}><$transclude tiddler=<<currentRecord>> field="caption"/></$link>
</$let>
<%else%>
<$link to=<<currentRecord>>><$text text=<<currentRecord>> /></$link>
<%endif%>
<%if [<tempTableEdit>getindex[mode]match[edit]] %><!-- only works in edit mode-->
  <$button popup=<<rename-popup-state>> popupAbsCoords="yes" class="tc-btn-invisible" tooltip=<<dyntable-lingo-text "Tables/Rename/Tooltip">> aria-label=<<dyntable-lingo-text "Tables/Rename/Tooltip">>>
	  {{$:/core/images/edit-button}}
	</$button>
  <$reveal state=<<rename-popup-state>> type="popup" position="below" animate="yes" class="tc-drop-down">
    <div class="nk-dyntable-clone-popup tc-popup-keep">
      <$edit-text tiddler=<<tempTableRenameName>> index=<<currentRecord>> default=<<currentRecord>> tag="input" class="nk-dyntable-textbox" focus="true" tooltip=<<dyntable-lingo-text "Tables/Rename/NameLabel">>/>
      <%if [<rename-newtitle-value>!match<currentRecord>] +[!is[missing]] %>
        <div class="nk-dyntable-clone-warning">{{$:/core/images/warning}} <<dyntable-lingo-text "Tables/Rename/ExistsWarning">></div>
      <%endif%>
      <$button class="tc-btn-invisible" tooltip=<<dyntable-lingo-text "Tables/Rename/Confirm">> aria-label=<<dyntable-lingo-text "Tables/Rename/Confirm">> actions=<<rename-record-as>>>{{$:/core/images/done-button}} <<dyntable-lingo "Tables/Rename/Confirm">></$button>
      <$button class="tc-btn-invisible" tooltip=<<dyntable-lingo-text "Tables/Rename/Cancel">> aria-label=<<dyntable-lingo-text "Tables/Rename/Cancel">> actions=<<close-rename>>>{{$:/core/images/close-button}}</$button>
    </div>
  </$reveal>
<%endif%>
</td>
