title: $:/plugins/nikorion/dyntable/segments/nk-dyntable-tfoot
type: text/vnd.tiddlywiki

\function frows() "[range[1,$(footerRows)$]addprefix[footer-]]" :map[substitute[]]

<!-- Computed rows: one row per spec of `footer` ("calc[:decimals][@col1,col2]"), no state stored -->
<$list filter="[enlist<footer>]" variable=spec>
<$let head={{{ [<spec>split[@]first[]] }}}
      cols={{{ [<spec>split[@]nth[2]] }}}
      calc={{{ [<head>split[:]first[]] }}}
      pn={{{ [<head>split[:]nth[2]else[0]] }}}
      fname={{{ [[min]match<calc>then[minall]] [[max]match<calc>then[maxall]] [enlist[sum average count unique median product range minall maxall]match<calc>] +[first[]] }}}
      key={{{ [[minall]match<fname>then[Minimum]] [[maxall]match<fname>then[Maximum]] [<fname>!match[minall]!match[maxall]titlecase[]] +[first[]] }}}
      tipName={{{ [function[dyntable-lingo-value],[Tables/FooterName/],<key>] }}}
      tipDesc={{{ [function[dyntable-lingo-value],[Tables/FooterDesc/],<key>] }}}
      label={{{ [function[dyntable-lingo-value],[Tables/Footer/],<key>else<calc>] }}}
      labelCol={{{ [function[visible-columns]!prefix[nk-]first[]] }}}
      lead={{{ [function[visible-columns]allbefore<labelCol>count[]add[1]] }}}
      leadCols={{{ [function[visible-columns]allbefore<labelCol>] [<labelCol>] }}}><!-- the label spans the leading action columns (nk-checkbox…) up to the first data column -->
<tr>
<$list filter="[function[visible-columns]]" variable=currentColumn>
<%if [function[visible-columns]first[]match<currentColumn>] %>
<td colspan=<<lead>>><span class="nk-dyntable-footer-label"><$text text=<<label>>/><<dyntable-lingo "Tables/Footer/LabelSuffix">><span class="nk-dyntable-footer-tip"><strong><$text text=<<tipName>>/></strong><br><$text text=<<tipDesc>>/></span></span></td>
<%elseif [enlist<leadCols>match<currentColumn>] %>
<%else%>
<td>
<%if [<fname>!is[blank]] %>
	<$let vals={{{ [function[column-values]count[]] }}}
	      bad={{{ [function[column-values]!regexp[^-?\d+(\.\d+)?$]count[]] }}}
	      numeric={{{ [<vals>compare:integer:gt[0]] :filter[<bad>match[0]] }}}
	      show={{{ [<cols>is[blank]then[y]] :filter[<numeric>!is[blank]] :else[<cols>split[,]trim[]match<currentColumn>] }}}>
		<%if [<show>!is[blank]] %>
			<$let result={{{ [function<fname>,<pn>] }}}>
				<%if [<result>!is[blank]] %><$transclude $variable="show-number" value=<<result>>/><%endif%>
			</$let>
		<%endif%>
	</$let>
<%endif%>
</td>
<%endif%>
</$list>
</tr>
</$let>
</$list>

<!-- Manual rows: editable cells stored in the keepstate tiddler -->
<%if [<footerRows>compare:integer:gt[0]] %>
<$list filter=<<frows>> variable=footerRow>
<tr>
<$list filter="[function[visible-columns]]" variable=currentColumn>
	<$set name="footerLookup"
				filter="[all[tiddlers+shadows]tag[$:/tags/nk-dyntable/FooterTemplate]!is[draft]contains:nk-dyntable-column-list<currentColumn>limit[1]get[title]]"
				value=<<footerLookup>>
				emptyValue="$:/plugins/nikorion/dyntable/templates/footer/default">
	<$transclude $tiddler=<<footerLookup>> $field="text" $mode="inline"/>
	</$set>
</$list>
</tr>
</$list>
<%endif%>

<<pagination-footer>>
