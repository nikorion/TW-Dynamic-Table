/* Whole-row tones, for the classes a row-class filter gives a record (see nk-dyntable-row-class() in
   segments/nk-dyntable-tbody), both theme-aware: nk-dyntable-row-success (done: faint green background),
   nk-dyntable-row-danger (set aside: faint red background). */

/* A translucent colour laid as a background image over each cell: it tints whatever lies beneath
   (a striped cell's colour, the row's hover grey) instead of hiding it. */
.nk-dyntable-container tbody tr.nk-dyntable-row-success > td {
<%if [<nk-dyntable-color-scheme>match[dark]] %>
background-image: linear-gradient(rgba(25, 135, 84, 0.25), rgba(25, 135, 84, 0.25)); /* dark green on dark */
<%else%>
background-image: linear-gradient(rgba(25, 135, 84, 0.1), rgba(25, 135, 84, 0.1)); /* faint green on light */
<%endif%>
}

.nk-dyntable-container tbody tr.nk-dyntable-row-danger > td {
<%if [<nk-dyntable-color-scheme>match[dark]] %>
background-image: linear-gradient(rgba(220, 53, 69, 0.25), rgba(220, 53, 69, 0.25)); /* dark red on dark */
<%else%>
background-image: linear-gradient(rgba(220, 53, 69, 0.1), rgba(220, 53, 69, 0.1)); /* faint red on light */
<%endif%>
}
