tags: $:/tags/nk-dyntable/Procedure
title: $:/plugins/nikorion/dyntable/procedures/nk-dyntable-toggle-edit-view
type: text/vnd.tiddlywiki

\procedure toggle-edit-view()

\procedure clear-mark-for-delete() 	
<$action-setfield $tiddler="$:/temp/nikorion/dyntable/delete-all-records" $index=<<currentTable>>/>
\end clear-mark-for-delete

<%if [<tempTableEdit>getindex[mode]match[edit]] %>
<$button class="tc-btn-invisible tc-tiddlylink" tooltip=<<dyntable-lingo-text "Tables/Edit/DoneTooltip">> aria-label=<<dyntable-lingo-text "Tables/Edit/DoneTooltip">> setTitle=<<tempTableEdit>> setIndex="mode" setTo="view" actions=<<clear-mark-for-delete>> >{{$:/core/images/done-button}}</$button>
<%else%>
<$button class="tc-btn-invisible tc-tiddlylink" tooltip=<<dyntable-lingo-text "Tables/Edit/EditTooltip">> aria-label=<<dyntable-lingo-text "Tables/Edit/EditTooltip">> setTitle=<<tempTableEdit>> setIndex="mode" setTo="edit">{{$:/core/images/edit-button}}</$button>
<%endif%>

\end toggle-edit-view
<!--clear-mark-for-delete
clears the status of currentTable if it is marked to be deleted
-->
