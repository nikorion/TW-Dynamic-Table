tags: $:/tags/nk-Table/Procedure
title: $:/plugins/nikorion/dyntable/procedures/dt-helper
type: text/vnd.tiddlywiki

\procedure baseState()        $:/state/nikorion/dyntable
\procedure persistentState()  $:/keepstate/nikorion/dyntable

\function keepstate()       [[$(persistentState)$/$(currentTable)$]substitute[]]

\function stateTableFooter() [[$(keepstate)$/footer]substitute[]]
\function stateWarningMsg()  [[$(keepstate)$/warning]substitute[]]

\function pageStateTiddler()          [[$(keepstate)$/page-number]substitute[]]
\function entryPerPageStateTiddler()  [[$(keepstate)$/entry-per-page]substitute[]]

<!-- localised label of the current column: Tables/Column/<name> key, else the raw field/index name -->
\function column-label()  [function[table-lingo-value],[Tables/Column/],<currentColumn>]

<!-- TW-Base-Fields vocabulary columns (role, maturity, lifecycle, needs, status): the vocabulary of the
  current column, when that plugin is installed. Without it the column shows the raw stored value and
  edits it as free text — never call the bf-vocab-* functions then: an unresolved `function[]` operator
  silently returns every tiddler in the wiki, which would fill the dropdown with random titles and
  corrupt the record's field on the next pick -->
\function tbl-bf-vocab() [[$:/plugins/nikorion/base-fields/vocab/]addsuffix<currentColumn>get[list]!is[blank]]
\procedure tbl-raw-cell() <$text text={{{ [<currentRecord>get<currentColumn>] }}}/>
\procedure tbl-raw-edit(actions) <$edit-text tiddler=<<currentRecord>> field=<<currentColumn>> tag="input" class="tbldyn-textbox" inputActions=<<actions>>/>



<!--
 Those tiddlers based on keepstate are permanent.
 These are tiddlers hold the data and setting for footer, styles and warning (needs to be hold).
 These state and temporary tiddlers are independent of currentTiddler (host tiddler) and on changing
 the title of host tiddler will not disconnected to table
-->

<!-- Columns actually rendered: the clone/delete action columns only exist in edit mode, so colspans and footer
     rows must not count them in view mode -->
\function visible-columns() [<tempTableEdit>getindex[mode]match[edit]] :then[subfilter<columnFilter>] :else[subfilter<columnFilter>!match[tbl-clone]!match[tbl-delete]]
