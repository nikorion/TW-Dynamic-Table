tags: $:/tags/nk-dyntable/Procedure
title: $:/plugins/nikorion/dyntable/procedures/nk-dyntable-helper
type: text/vnd.tiddlywiki

\procedure baseState()        $:/state/nikorion/dyntable
\procedure persistentState()  $:/keepstate/nikorion/dyntable

\function keepstate()       [[$(persistentState)$/$(currentTable)$]substitute[]]

\function stateTableFooter() [[$(keepstate)$/footer]substitute[]]
\function stateWarningMsg()  [[$(keepstate)$/warning]substitute[]]

\function pageStateTiddler()          [[$(keepstate)$/page-number]substitute[]]
\function entryPerPageStateTiddler()  [[$(keepstate)$/entry-per-page]substitute[]]

<!-- localised label of the current column: the first label given by a tiddler tagged
  $:/tags/nk-dyntable/ColumnLabelFilter (a filter evaluated with currentTiddler and currentColumn set to the
  column: how another plugin names the columns it knows), else the Tables/Column/<name> key, else the raw
  field/index name. A label filter must return nothing, not an empty string, for a column it does not know:
  :cascade stops at the first filter with any output. -->
\function column-label()  [<currentColumn>] :cascade[all[shadows+tiddlers]tag[$:/tags/nk-dyntable/ColumnLabelFilter]!is[draft]get[text]] :and[!is[blank]] :else[function[dyntable-lingo-value],[Tables/Column/],<currentColumn>]

<!-- tooltip of the current column's header: the first hint given by a tiddler tagged
  $:/tags/nk-dyntable/ColumnHintFilter (same contract as the label filters: evaluated with currentTiddler and
  currentColumn set to the column, nothing for a column it does not know), else none. -->
\function column-hint()  [<currentColumn>] :cascade[all[shadows+tiddlers]tag[$:/tags/nk-dyntable/ColumnHintFilter]!is[draft]get[text]] :and[!is[blank]]



<!--
 Those tiddlers based on keepstate are permanent.
 These are tiddlers hold the data and setting for footer, styles and warning (needs to be hold).
 These state and temporary tiddlers are independent of currentTiddler (host tiddler) and on changing
 the title of host tiddler will not disconnected to table
-->

<!-- Columns actually rendered: the clone/delete action columns only exist in edit mode, so colspans and footer
     rows must not count them in view mode -->
\function visible-columns() [<tempTableEdit>getindex[mode]match[edit]] :then[subfilter<columnFilter>] :else[subfilter<columnFilter>!match[nk-clone]!match[nk-delete]]
