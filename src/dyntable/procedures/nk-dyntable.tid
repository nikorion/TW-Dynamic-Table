tags: $:/tags/Global
title: $:/plugins/nikorion/dyntable/procedures/nk-dyntable
type: text/vnd.tiddlywiki

\procedure dyntable( filter, fields:"", indexes:"", sortType:"string", caption:"", class:"",
                  footer:"", footerRows:"0",stateTiddler:"", editButton:"yes", pagination:"no", 
				  emptyMessage:"<<dyntable-lingo Tables/EmptyMessage>>")

<!--above commands import utility macros-->
\import [all[shadows+tiddlers]tag[$:/tags/nk-dyntable/Procedure]!is[draft]]
<$let inputFilter="[subfilter<filter>!has[draft.of]]" >
<!--check input filter parameter-->
<%if [<fields>is[blank]then[f]] [<indexes>is[blank]then[i]] :and[count[]match[2]] %><!--no column source given -->
	<span class="tc-error"><<dyntable-lingo "Tables/Error/NoColumns">></span>
<%elseif [<fields>!is[blank]then[f]] [<indexes>!is[blank]then[i]] :and[count[]match[2]] %><!--ambiguous: both column sources given -->
	<span class="tc-error"><<dyntable-lingo "Tables/Error/BothColumns">></span>
<%elseif [subfilter<inputFilter>limit[1]] %><!--check the input filter is not empty -->
<$let 
 dataType =        {{{ [<fields>!is[blank]then[field]] [<indexes>!is[blank]then[index]] +[last[]] }}}
 columnFilter =    {{{ [<dataType>match[field]then<fields>else<indexes>] }}} 
 currentTable =    {{{ [<stateTiddler>!is[blank]else<currentTiddler>]  }}}
 
 tempTable =       {{{ [<baseState>][<currentTable>]    +[join[/]] }}}
 tempTableSort =   {{{ [<tempTable>] "sortby"           +[join[/]] }}}
 tempTableExpand = {{{ [<tempTable>] "expand"           +[join[/]] }}}
 tempTableEdit =   {{{ [<tempTable>] "edit-view-status" +[join[/]] }}}
 columnsCount =    {{{ [function[visible-columns]count[]] }}}
 
 sortIndex =       {{{ [<tempTableSort>getindex[sortIndex]]  }}} 
 sortFlag =        {{{ [<tempTableSort>getindex[sortFlag]]   }}}
>

<div data-bs-theme=<<nk-dyntable-color-scheme>> class="nk-dyntable-container" style="max-width:100%;">
	<table class=<<class>> style="caption-side:top">
		<!-- reveal caption and edit button -------------------->
		<caption style="text-align:left;">
			<%if [<editButton>match[yes]] %>
				<span style="padding-right:5px;padding-left:3px;"><<toggle-edit-view>></span>
			<%endif%>
			<<caption>>
		</caption>
		<!-- create header -------------------->
		<thead>
			<$transclude $tiddler="$:/plugins/nikorion/dyntable/segments/nk-dyntable-thead"/>
		</thead>
		<!-- reveal main body of table (generate records) -------------------->
		<tbody>
			<$transclude $tiddler="$:/plugins/nikorion/dyntable/segments/nk-dyntable-tbody"/>
		</tbody>
		<!-- create footer -------------------->
		<tfoot class="nk-dyntable-footer">
			<$transclude $tiddler="$:/plugins/nikorion/dyntable/segments/nk-dyntable-tfoot"/>
		</tfoot>
	</table>
</div><!-- container-->
</$let>
<%else%>
	<<emptyMessage>>
<%endif%><!--check the input filter is not empty -->
</$let>
\end dyntable