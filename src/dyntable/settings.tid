title: $:/plugins/nikorion/dyntable/settings
tags: $:/tags/ControlPanel/SettingsTab
caption: <<dyntable-lingo Settings/Caption>>
type: text/vnd.tiddlywiki

\whitespace trim

<h2><<dyntable-lingo Settings/Heading>></h2>

<p><<dyntable-lingo Settings/Intro>></p>

<table class="tc-pref-table tc-table-no-border">
<tbody>
<tr>
<td><<dyntable-lingo Settings/Label/EditorType>></td>
<td><$select tiddler="$:/config/nikorion/dyntable/editor-type" field="text" default="simple">
<option value="simple"><<dyntable-lingo-text Settings/Option/Simple>></option>
<option value="main-editor"><<dyntable-lingo-text Settings/Option/MainEditor>></option>
</$select></td>
<td><em><<dyntable-lingo-text Settings/DefaultLabel>>&nbsp;<code>simple</code></em></td>
<td><$list filter="[[$:/config/nikorion/dyntable/editor-type]is[tiddler]]"><$button tooltip=<<dyntable-lingo-text Settings/ResetTooltip>>>
<$action-deletetiddler $tiddler="$:/config/nikorion/dyntable/editor-type"/>↺</$button></$list></td>
</tr>
<tr>
<td><<dyntable-lingo Settings/Label/EntriesPerPage>></td>
<td><$select tiddler="$:/config/nikorion/dyntable/entries-per-page" field="text" default="25">
<$list filter='5 10 15 20 25 30 40 50' variable=num>
<option value=<<num>>><<num>></option>
</$list>
</$select></td>
<td><em><<dyntable-lingo-text Settings/DefaultLabel>>&nbsp;<code>25</code></em></td>
<td><$list filter="[[$:/config/nikorion/dyntable/entries-per-page]is[tiddler]]"><$button tooltip=<<dyntable-lingo-text Settings/ResetTooltip>>>
<$action-deletetiddler $tiddler="$:/config/nikorion/dyntable/entries-per-page"/>↺</$button></$list></td>
</tr>
</tbody>
</table>
