{
  "description": "TW-Dynamic-Table development wiki",
  "plugins": [
    "tiddlywiki/filesystem",
    "tiddlywiki/tiddlyweb",
    "nikorion/dyntable",
    "nikorion/base-fields",
    "nikorion/plugin-info-tree",
    "nikorion/tiny-bootstrap",
    "nikorion/math",
    "nikorion/scroll-layout",
    "nikorion/detect-language"
  ],
  "themes": [
    "tiddlywiki/vanilla"
  ],
  "languages": [
    "fr-FR"
  ],
  "pluginPath": ["../src", "../../TW-Base-Fields/src", "../../TW-Plugin-Info-Tree/src", "../../TW-Tiny-Bootstrap/src", "../../TW-Math/src", "../../TW-Scroll-Layout/src"],
  "config": {
    "retain-original-tiddler-path": true
  },
  "build": {
    "plugin-json": [
      "--output", "dist",
      "--render", "$:/core/templates/exporters/JsonFile", "TW-Dynamic-Table-Plugin.json", "text/plain", "", "exportFilter", "[[$:/plugins/nikorion/dyntable]]"
    ],
    "html": [
      "--output", "docs",
      "--rendertiddler", "$:/core/save/all", "TW-Dynamic-Table-Wiki.html", "text/plain", "",
      "publishFilter", "-[[$:/dev/hmr]] -[[$:/config/dev/hmr-port]] -[[$:/config/SyncFilter]] -[[$:/config/FileSystemPaths]] -[[$:/config/OriginalTiddlerPaths]]"
    ]
  }
}
